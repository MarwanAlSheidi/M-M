# Parse / Back4app
PARSE_APP_ID=
PARSE_JS_KEY=
PARSE_MASTER_KEY=
PARSE_SERVER_URL=https://parseapi.back4app.com

# بوابة الدفع — ثواني (اتركها فارغة في مرحلة الـ MVP التطوّعي)
THAWANI_BASE_URL=https://uatcheckout.thawani.om/api/v1
THAWANI_SECRET_KEY=
THAWANI_PUBLISHABLE_KEY=
PAYMENT_SUCCESS_URL=masjidi://payment/success
PAYMENT_CANCEL_URL=masjidi://payment/cancel
# سرّ نقطة نهاية البوابة — يُسجَّل في لوحة ثواني ويُولَّد عشوائياً
PAYMENT_WEBHOOK_SECRET=

# مضيفو الملفات المسموح بروابطهم في صور الإنجاز (مفصولون بفواصل).
# مضيف الخادم و parsefiles.back4app.com مضافان تلقائياً.
FILE_HOST_ALLOWLIST=

# منصة أيادي (مستقبلاً)
AYADI_API_KEY=

# خرائط جوجل — اختياري.
# الخريطة في الواجهة تعمل بدونه (VITE_GOOGLE_MAPS_API_KEY في app/)، وهذا
# المفتاح لسكربت استخراج مواقع المساجد المجهولة من Places API.
# يحتاج تفعيل «Places API (New)»، والبحث النصّي مدفوع — انظر docs/DEPLOY.md
GOOGLE_MAPS_API_KEY=
